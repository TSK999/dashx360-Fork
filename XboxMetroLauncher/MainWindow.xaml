                  <TextBlock Text="&lt;" FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold" LineHeight="26" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Button>
                <TextBlock Foreground="#FF333333" FontSize="30" FontWeight="Light" Margin="16,0" VerticalAlignment="Center" Text="{Binding CurrentDashboardCustomizationTabName}" />
                <Button x:Name="DashboardCustomizerNextTabButton" Width="44" Height="36" Padding="0" Style="{StaticResource SettingsActionButtonStyle}" FocusVisualStyle="{x:Null}" Command="{Binding NextDashboardCustomizerTabCommand}">
                  <TextBlock Text="&gt;" FontFamily="Segoe UI" FontSize="26" FontWeight="SemiBold" LineHeight="26" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                </Button>
                <TextBlock Text="Customize Dashboard" Foreground="#AA333333" FontSize="18" Margin="22,8,0,0" />
              </StackPanel>
              <Border Grid.Row="1" Width="690" Height="360" Margin="0,22,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FF5F6668" ClipToBounds="False">
                <Viewbox Stretch="Uniform" ClipToBounds="False">
                  <Canvas Width="806" Height="368" ClipToBounds="False">
                    <ItemsControl ClipToBounds="False" ItemsSource="{Binding CurrentDashboardCustomizationTab.Tiles}" Canvas.Left="{Binding CurrentDashboardCustomizationTab.ContentMargin.Left}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas Width="806" Height="368" ClipToBounds="False" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemContainerStyle>
                        <Style TargetType="{x:Type ContentPresenter}">
                          <Setter Property="Canvas.Left" Value="{Binding Left}" />
                          <Setter Property="Canvas.Top" Value="{Binding Top}" />
                          <Setter Property="Panel.ZIndex" Value="1" />
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource X360TileButtonStyle}" Width="{Binding Width}" Height="{Binding Height}" Command="{Binding DataContext.SelectDashboardTileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <Grid ClipToBounds="True">
                              <Border Background="{DynamicResource MetroGreenBrush}" />
                              <Border Background="{Binding PlaceholderBrush}" />
                              <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="Fant">
                                <Image.Source>
                                  <MultiBinding Converter="{StaticResource DashboardTilePreviewImageSourceConverter}">
                                    <Binding Path="ImagePath" />
                                    <Binding Path="Zoom" />
                                    <Binding Path="OffsetX" />
                                    <Binding Path="OffsetY" />
                                    <Binding Path="DefaultImagePath" />
                                  </MultiBinding>
                                </Image.Source>
                              </Image>
                              <Rectangle VerticalAlignment="Bottom" Fill="#99000000">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type Rectangle}">
                                    <Setter Property="Height" Value="30" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding AllowsSecondaryTitleCustomization}" Value="True">
                                        <Setter Property="Height" Value="44" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </Rectangle>
                              <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="{Binding TitleFontSize}" Margin="{Binding TitleMargin}">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding AllowsSecondaryTitleCustomization}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </TextBlock>
                              <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="{Binding TitleFontSize}" Margin="8,0,8,23" Visibility="{Binding AllowsSecondaryTitleCustomization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Text="{Binding SecondaryTitle}" Foreground="#DFFFFFFF" FontSize="{Binding TitleFontSize}" Margin="8,0,8,7" Visibility="{Binding AllowsSecondaryTitleCustomization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                              <Border BorderBrush="#F2FFFFFF" BorderThickness="3" Opacity="0">
                                <FrameworkElement.Style>
                                  <Style TargetType="{x:Type Border}">
                                    <Style.Triggers>
                                      <DataTrigger Value="True" Binding="{Binding IsSelected}">
                                        <Setter Property="UIElement.Opacity" Value="1" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </FrameworkElement.Style>
                              </Border>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Canvas>
                </Viewbox>
              </Border>
              <ScrollViewer Grid.Row="1" Grid.Column="2" Panel.ZIndex="20" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel>
                  <TextBlock Foreground="#FF333333" FontSize="23" FontWeight="Light" Margin="0,0,0,6" Text="{Binding SelectedDashboardTileTitle}" />
                  <TextBlock Foreground="#AA333333" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding SelectedDashboardTileCustomizationHint}" />
                  <Border Background="#DDE6E9E9" BorderBrush="#88FFFFFF" BorderThickness="1" Padding="10,9,10,10" Margin="0,0,0,14">
                    <StackPanel>
                      <TextBlock Text="Tile labels" Foreground="#88333333" FontSize="15" Margin="0,0,0,8" />
                      <TextBlock Text="Tile Text" Foreground="#FF333333" FontSize="16" />
                      <TextBox Height="36" FontSize="18" Margin="0,4,0,9" Padding="10,4" BorderBrush="#AAC8C8C8" BorderThickness="1" Background="#F9FFFFFF" Foreground="#FF222222" Text="{Binding SelectedDashboardTile.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      <StackPanel Visibility="{Binding SelectedDashboardTileAllowsSecondaryTitleCustomization, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="2nd Tile Text" Foreground="#FF333333" FontSize="16" />
                        <TextBox Height="36" FontSize="18" Margin="0,4,0,0" Padding="10,4" BorderBrush="#AAC8C8C8" BorderThickness="1" Background="#F9FFFFFF" Foreground="#FF222222" Text="{Binding SelectedDashboardTile.SecondaryTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                      <StackPanel Visibility="{Binding SelectedDashboardTileAllowsLaunchCustomization, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Executable" Foreground="#FF333333" FontSize="16" Margin="0,10,0,0" />
                        <Grid Height="36" Margin="0,4,0,9">
                          <TextBox FontSize="14" Padding="10,5,48,4" BorderBrush="#AAC8C8C8" BorderThickness="1" Background="#F9FFFFFF" Foreground="#FF222222" Text="{Binding SelectedDashboardTile.LaunchExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          <Button Content="..." Width="44" HorizontalAlignment="Right" Style="{StaticResource SettingsActionButtonStyle}" Padding="0" Command="{Binding ChooseDashboardTileExecutableCommand}" />
                        </Grid>
                        <TextBlock Text="Web Address" Foreground="#FF333333" FontSize="16" />
                        <TextBox Height="36" FontSize="14" Margin="0,4,0,0" Padding="10,5" BorderBrush="#AAC8C8C8" BorderThickness="1" Background="#F9FFFFFF" Foreground="#FF222222" Text="{Binding SelectedDashboardTile.LaunchWebAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Button Content="Reset Text" Style="{StaticResource SettingsActionButtonStyle}" Margin="0,0,0,14" Command="{Binding ResetDashboardTileTitleCommand}" />
                  <Button Content="Choose Image" Style="{StaticResource SettingsActionButtonStyle}" Command="{Binding ChooseDashboardTileImageCommand}" Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Button Content="Reset Image" Style="{StaticResource SettingsActionButtonStyle}" Margin="0,8,0,14" Command="{Binding ResetDashboardTileImageCommand}" Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <TextBlock Text="Zoom" Foreground="#FF333333" FontSize="16" Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Slider Minimum="1" Maximum="2.5" Value="{Binding SelectedDashboardTile.Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <TextBlock Text="Horizontal crop" Foreground="#FF333333" FontSize="16" Margin="0,8,0,0" Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Slider Minimum="-1" Maximum="1" Value="{Binding SelectedDashboardTile.OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <TextBlock Text="Vertical crop" Foreground="#FF333333" FontSize="16" Margin="0,8,0,0" Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <Slider Minimum="-1" Maximum="1" Value="{Binding SelectedDashboardTile.OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <StackPanel Visibility="{Binding SelectedDashboardTileUsesDashboardColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="Tile Color" Style="{StaticResource SettingsActionButtonStyle}" Margin="0,20,0,8" Command="{Binding OpenDashboardTileColorPickerCommand}" />
                    <Border Height="32" BorderBrush="#99FFFFFF" BorderThickness="1" Margin="0,0,0,8" Background="{Binding DashboardTileColorPreviewBrush}" />
                    <TextBlock Text="Red" Foreground="#FF333333" FontSize="14" />
                    <Slider Minimum="0" Maximum="255" Value="{Binding CustomTileRed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Green" Foreground="#FF333333" FontSize="14" />
                    <Slider Minimum="0" Maximum="255" Value="{Binding CustomTileGreen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Blue" Foreground="#FF333333" FontSize="14" />
                    <Slider Minimum="0" Maximum="255" Value="{Binding CustomTileBlue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" ZIndex="20" Margin="0,14,0,0">
                <Button Content="Reset Tab" Style="{StaticResource SettingsActionButtonStyle}" Command="{Binding ResetDashboardTabImagesCommand}" />
                <Button Content="Reset Color" Style="{StaticResource SettingsActionButtonStyle}" Margin="10,0,0,0" Command="{Binding ResetDashboardTileColorCommand}" />
                <Button Content="Back" Style="{StaticResource SettingsActionButtonStyle}" Margin="10,0,0,0" Command="{Binding CloseDashboardCustomizerCommand}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Grid Name="ThemeCreatorOverlay" FocusManager.IsFocusScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsThemeCreatorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Rectangle Fill="#77000000" />
          <Border Width="980" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F1F4F4F4" BorderBrush="#88FFFFFF" BorderThickness="1">
            <Grid Margin="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="1*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="Create Theme" Foreground="#FF333333" FontSize="28" FontWeight="SemiBold" Grid.ColumnSpan="2" />
