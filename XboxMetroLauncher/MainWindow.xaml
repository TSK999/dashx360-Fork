          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="92,0,0,45">
            <Border Width="18" Height="18" CornerRadius="9" Background="#FF6CB344">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text=" Select   " Foreground="#FFFFFFFF" FontSize="15" />
            <Border Width="18" Height="18" CornerRadius="9" Background="#FFD73A3A" Cursor="Hand" MouseLeftButtonUp="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text=" Back" Foreground="#FFFFFFFF" FontSize="15" Cursor="Hand" MouseLeftButtonUp="BackHint_OnMouseLeftButtonUp" />
          </StackPanel>
        </Grid>
        <Grid Name="MusicPlayerOverlay" FocusManager.IsFocusScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsMusicPlayerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <FrameworkElement.Resources>
            <ResourceDictionary>
              <Style x:Key="MusicPlayerButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="#FF333333" />
                <Setter Property="Background" Value="#FFE8ECEC" />
                <Setter Property="BorderBrush" Value="#55FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Name="Root" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                          <Setter Property="Foreground" Value="#FFFFFFFF" />
                          <Setter Property="Background" Value="{DynamicResource MetroGreenBrush}" />
                          <Setter Property="BorderBrush" Value="#FFFFFFFF" />
                          <Setter Property="BorderThickness" Value="2" />
                          <Setter TargetName="Root" Property="UIElement.Effect">
                            <Setter.Value>
                              <DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="White" Opacity="0.35" />
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="Foreground" Value="#FFFFFFFF" />
                          <Setter Property="Background" Value="{DynamicResource MetroGreenBrush}" />
                          <Setter Property="BorderBrush" Value="#FFFFFFFF" />
                          <Setter Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                          <Setter Property="Foreground" Value="#FFFFFFFF" />
                          <Setter Property="Background" Value="{DynamicResource MetroGreenBrush}" />
                          <Setter Property="BorderBrush" Value="{DynamicResource MetroGreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter Property="Background" Value="{DynamicResource MetroGreenDarkBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
              <Style x:Key="MusicTrackButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Grid>
                        <ContentPresenter />
                        <Border Name="FocusFrame" BorderBrush="{DynamicResource MetroGreenBrush}" BorderThickness="4" Opacity="0" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                          <Setter TargetName="FocusFrame" Property="UIElement.Opacity" Value="1" />
                          <Setter Property="Panel.ZIndex" Value="10" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter Property="UIElement.Opacity" Value="0.82" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
              <Style x:Key="MusicBrowserMenuButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#E6EEF1F1" />
                <Setter Property="Foreground" Value="#FF30383A" />
                <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="{TemplateBinding Control.Background}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource MetroGreenBrush}" />
                          <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </DataTrigger>
                        <Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                          <Setter Property="Background" Value="{DynamicResource MetroGreenBrush}" />
                          <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{DynamicResource MetroGreenBrush}" />
                          <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter Property="Background" Value="{DynamicResource MetroGreenDarkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                          <Setter Property="Background" Value="#DDE8ECEC" />
