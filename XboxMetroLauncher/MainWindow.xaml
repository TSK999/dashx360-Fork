                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Steam Setup" Foreground="#FF333333" FontSize="30" FontWeight="SemiBold" />
