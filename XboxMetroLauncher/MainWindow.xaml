                    <TextBox Height="42" FontSize="20" VerticalContentAlignment="Center" Text="{Binding SteamSetupApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
