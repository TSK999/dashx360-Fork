                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Save Theme" Style="{StaticResource SettingsActionButtonStyle}" Width="180" Margin="0,0,10,0" Command="{Binding SaveThemeCommand}" />
                <Button Content="Back" Style="{StaticResource SettingsActionButtonStyle}" Width="140" Command="{Binding CloseThemeCreatorCommand}" />
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="92,0,0,45">
            <Border Width="18" Height="18" CornerRadius="9" Background="#FF6CB344">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text=" Select   " Foreground="#FFFFFFFF" FontSize="15" />
            <Border Width="18" Height="18" CornerRadius="9" Background="#FFD73A3A" Cursor="Hand" MouseLeftButtonUp="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text=" Back" Foreground="#FFFFFFFF" FontSize="15" Cursor="Hand" MouseLeftButtonUp="BackHint_OnMouseLeftButtonUp" />
          </StackPanel>
        </Grid>
        <Grid Name="SteamSetupOverlay" FocusManager.IsFocusScope="True" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" Visibility="{Binding IsSteamSetupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Rectangle Fill="#77000000" />
